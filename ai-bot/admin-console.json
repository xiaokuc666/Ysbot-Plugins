{
  "version": 1,
  "config": {
    "title": "AI Bot 配置",
    "groups": [
      {
        "id": "general",
        "title": "通用"
      },
      {
        "id": "reply",
        "title": "回复"
      },
      {
        "id": "admin",
        "title": "管理"
      }
    ],
    "schema": {
      "type": "object",
      "properties": {
        "defaultEnabled": {
          "type": "boolean",
          "default": false,
          "title": "默认启用"
        },
        "privateEnabled": {
          "type": "boolean",
          "default": false,
          "title": "私聊回复"
        },
        "defaultReplyMode": {
          "type": "string",
          "enum": ["mention", "all"],
          "default": "mention",
          "title": "默认回复模式"
        },
        "enabledGroups": {
          "type": "array",
          "default": [],
          "title": "启用群"
        },
        "disabledGroups": {
          "type": "array",
          "default": [],
          "title": "禁用群"
        },
        "adminUserIds": {
          "type": "array",
          "default": [],
          "title": "管理员 QQ"
        },
        "systemPrompt": {
          "type": "string",
          "default": "你是 YSbot，一个 QQ 机器人。回复保持简洁自然，不要暴露内部配置。",
          "title": "系统提示词"
        },
        "cooldownSeconds": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 300,
          "title": "冷却秒数"
        },
        "maxReplyLength": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "maximum": 10000,
          "title": "最大回复长度"
        },
        "llmProvider": {
          "type": "string",
          "default": "",
          "title": "LLM Provider"
        },
        "llmModel": {
          "type": "string",
          "default": "",
          "title": "LLM 模型"
        },
        "curiosityEnabled": {
          "type": "boolean",
          "default": false,
          "title": "启用好奇心总线"
        },
        "curiosityMemoryEnabled": {
          "type": "boolean",
          "default": true,
          "title": "启用记忆联动"
        },
        "curiosityDirectCooldownMs": {
          "type": "integer",
          "default": 15000,
          "minimum": 1000,
          "maximum": 3600000,
          "title": "直接互动冷却"
        },
        "curiosityGroupActiveCooldownMs": {
          "type": "integer",
          "default": 60000,
          "minimum": 1000,
          "maximum": 3600000,
          "title": "群活跃冷却"
        },
        "curiosityPeriodicProbeEnabled": {
          "type": "boolean",
          "default": false,
          "title": "启用定时群探针"
        },
        "curiosityPeriodicProbeIntervalMs": {
          "type": "integer",
          "default": 300000,
          "minimum": 10000,
          "maximum": 86400000,
          "title": "定时探针间隔"
        },
        "curiosityPeriodicProbeProbability": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "title": "定时探针参与概率"
        },
        "curiosityRandomReplyProbability": {
          "type": "number",
          "default": 0.05,
          "minimum": 0,
          "maximum": 1,
          "title": "群活跃随机回复概率"
        },
        "memoryRecallLimit": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "title": "记忆召回条数上限"
        },
        "memoryMaxInjection": {
          "type": "integer",
          "default": 2000,
          "minimum": 100,
          "maximum": 100000,
          "title": "记忆注入最大长度"
        },
        "historyMaxEntries": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "title": "短期历史最大条数"
        },
        "historyMaxAgeMs": {
          "type": "integer",
          "default": 3600000,
          "minimum": 60000,
          "maximum": 86400000,
          "title": "短期历史保留时间"
        },
        "timeZone": {
          "type": "string",
          "default": "Asia/Shanghai",
          "title": "时区"
        },
        "directAttentionWindowMs": {
          "type": "integer",
          "default": 30000,
          "minimum": 0,
          "maximum": 600000,
          "title": "@ 后注意力窗口"
        },
        "directAttentionFollowCooldownMs": {
          "type": "integer",
          "default": 5000,
          "minimum": 1000,
          "maximum": 120000,
          "title": "@ 后关注冷却"
        },
        "directAttentionFollowProbability": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "title": "@ 后关注概率"
        },
        "llmTools": {
          "type": "array",
          "default": [],
          "title": "LLM 工具定义 JSON"
        },
        "maxToolRounds": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "title": "最大工具轮数"
        },
        "replyWithAt": {
          "type": "boolean",
          "default": true,
          "title": "@ 时回复带 @"
        },
        "replyWithQuote": {
          "type": "boolean",
          "default": true,
          "title": "回复时引用原消息"
        }
      }
    },
    "secrets": []
  },
  "pages": []
}
