{
  "version": 1,
  "config": {
    "title": "Identity Store 配置",
    "groups": [
      {
        "id": "general",
        "title": "通用"
      },
      {
        "id": "retrieval",
        "title": "检索"
      },
      {
        "id": "consolidation",
        "title": "整合"
      },
      {
        "id": "privacy",
        "title": "隐私"
      }
    ],
    "schema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "title": "启用"
        },
        "retrievalMode": {
          "type": "string",
          "enum": ["hybrid", "stable", "dynamic", "full"],
          "default": "hybrid",
          "title": "检索模式"
        },
        "keywordWeight": {
          "type": "number",
          "default": 0.4,
          "title": "关键词权重"
        },
        "recencyWeight": {
          "type": "number",
          "default": 0.2,
          "title": "时间权重"
        },
        "salienceWeight": {
          "type": "number",
          "default": 0.3,
          "title": "显著性权重"
        },
        "permissionWeight": {
          "type": "number",
          "default": 0.1,
          "title": "权限权重"
        },
        "maxContextLength": {
          "type": "integer",
          "default": 2000,
          "minimum": 100,
          "maximum": 100000,
          "title": "最大身份上下文长度"
        },
        "consolidationEnabled": {
          "type": "boolean",
          "default": true,
          "title": "启用自我反思"
        },
        "minJournalEntries": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100000,
          "title": "反思最小事件数"
        },
        "consolidationIntervalMs": {
          "type": "integer",
          "default": 3600000,
          "minimum": 60000,
          "maximum": 86400000,
          "title": "反思间隔"
        },
        "maxBeliefs": {
          "type": "integer",
          "default": 200,
          "minimum": 1,
          "maximum": 100000,
          "title": "最大信念数"
        },
        "privacyHideFromUsers": {
          "type": "boolean",
          "default": true,
          "title": "对普通用户隐藏"
        },
        "privacyAdminOnly": {
          "type": "boolean",
          "default": true,
          "title": "仅管理员可改"
        }
      }
    },
    "secrets": []
  },
  "pages": [
    {
      "id": "identity",
      "title": "身份管理",
      "entry": "/api/plugins/identity-store/admin/identity",
      "theme": "shared"
    }
  ]
}
